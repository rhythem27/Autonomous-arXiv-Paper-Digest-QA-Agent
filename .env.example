# ==============================================================================
# Autonomous arXiv Paper Digest & QA Agent - Environment Configuration Example
# Copy this file to .env and insert your GEMINI_API_KEY
# ==============================================================================

# LLM Configuration (Google Gemini Free Tier)
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Embeddings (BAAI/bge-small-en-v1.5)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Vector Database (Qdrant Local)
# Embedded local path or Docker container URL (http://localhost:6333)
QDRANT_PATH=./qdrant_storage
QDRANT_URL=
QDRANT_COLLECTION_PREFIX=arxiv

# State Persistence (SQLite)
SQLITE_DB_PATH=./agent_state.db

# Storage & Cache Configuration
PDF_CACHE_DIR=./pdf_cache

# Search & Retrieval Settings
ARXIV_MAX_RESULTS=5
TOP_K_CHUNKS=4
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
